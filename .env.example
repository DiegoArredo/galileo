# =====================================================
# GALILEO PROJECT - Environment Variables Example
# =====================================================
# Rename this file to .env and fill in your values
# IMPORTANT: Never commit .env files with real secrets

# DATABASE - USERS SERVICE
USERS_DATABASE_HOST=pg-2ccdd4ab-galileo.f.aivencloud.com
USERS_DATABASE_PORT=25064
USERS_DATABASE_USER=avnadmin
USERS_DATABASE_PASSWORD=your_users_db_password
USERS_DATABASE_NAME=defaultdb
USERS_DATABASE_CA_CERT=your_users_ca_certificate

# DATABASE - COURSES SERVICE
COURSES_DATABASE_HOST=pg-1febce65-alumnos-c0a9.f.aivencloud.com
COURSES_DATABASE_PORT=26339
COURSES_DATABASE_USER=avnadmin
COURSES_DATABASE_PASSWORD=your_courses_db_password
COURSES_DATABASE_NAME=defaultdb
COURSES_DATABASE_CA_CERT=your_courses_ca_certificate

# DATABASE - CART SERVICE
CART_DATABASE_HOST=localhost
CART_DATABASE_PORT=5432
CART_DATABASE_USER=postgres
CART_DATABASE_PASSWORD=your_cart_db_password
CART_DATABASE_NAME=carrito

# GROQ AI (AI-BOT SERVICE)
GROQ_API_KEY=your_groq_api_key

# EMAIL (NOTIFICATION SERVICE)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=galileoelearning@gmail.com
SMTP_PASSWORD=your_smtp_app_password

# SMS (NOTIFICATION SERVICE - TWILIO)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+your_twilio_phone_number

# DIALOGFLOW / AI BOT SERVICE
DIALOGFLOW_PROJECT_ID=your_google_cloud_project_id
DIALOGFLOW_PRIVATE_KEY_ID=your_private_key_id
DIALOGFLOW_PRIVATE_KEY=your_private_key_in_base64_or_path
DIALOGFLOW_CLIENT_EMAIL=your_client_email@project.iam.gserviceaccount.com

# SERVICES PORTS
NOTIFICATION_SERVICE_PORT=3005
AI_BOT_SERVICE_PORT=3001
USERS_SERVICE_PORT=3002
COURSES_SERVICE_PORT=3003
CART_SERVICE_PORT=3004

# NODE ENVIRONMENT
NODE_ENV=development

# RABBITMQ (MICROSERVICES)
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
