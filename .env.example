# Galileo backend environment template
# Copy this file to .env and replace every placeholder with your local values.
# Never commit .env or real credentials.

# DATABASE - USERS SERVICE
USERS_DATABASE_HOST=your_users_database_host
USERS_DATABASE_PORT=your_users_database_port
USERS_DATABASE_USER=your_users_database_user
USERS_DATABASE_PASSWORD=your_users_database_password
USERS_DATABASE_NAME=your_users_database_name
USERS_DATABASE_CA_CERT=your_users_database_ca_certificate

# DATABASE - COURSES SERVICE
COURSES_DATABASE_HOST=your_courses_database_host
COURSES_DATABASE_PORT=your_courses_database_port
COURSES_DATABASE_USER=your_courses_database_user
COURSES_DATABASE_PASSWORD=your_courses_database_password
COURSES_DATABASE_NAME=your_courses_database_name
COURSES_DATABASE_CA_CERT=your_courses_database_ca_certificate

# DATABASE - CART SERVICE
CART_DATABASE_HOST=localhost
CART_DATABASE_PORT=5432
CART_DATABASE_USER=postgres
CART_DATABASE_PASSWORD=your_cart_database_password
CART_DATABASE_NAME=carrito

# GROQ AI (AI-BOT SERVICE)
GROQ_API_KEY=your_groq_api_key

# EMAIL (NOTIFICATION SERVICE)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_smtp_app_password

# SMS (NOTIFICATION SERVICE - TWILIO)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+your_twilio_phone_number

# DIALOGFLOW / AI BOT SERVICE
DIALOGFLOW_PROJECT_ID=your_google_cloud_project_id
DIALOGFLOW_PRIVATE_KEY_ID=your_private_key_id
DIALOGFLOW_PRIVATE_KEY=your_private_key_in_base64_or_path
DIALOGFLOW_CLIENT_EMAIL=your_client_email@project.iam.gserviceaccount.com

# SERVICES PORTS
NOTIFICATION_SERVICE_PORT=3005
AI_BOT_SERVICE_PORT=3001
USERS_SERVICE_PORT=3002
COURSES_SERVICE_PORT=3003
CART_SERVICE_PORT=3004

# NODE ENVIRONMENT
NODE_ENV=development

# RABBITMQ (MICROSERVICES)
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
