# =====================================================
# GALILEO PROJECT - Environment Variables Example
# =====================================================
# Rename this file to .env and fill in your values
# IMPORTANT: Never commit .env files with real secrets

# FRONTEND
REACT_APP_API_URL=http://localhost:3001/graphql

# DATABASE - USERS SERVICE
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password
DATABASE_NAME=users_db

# DATABASE - COURSES SERVICE
COURSES_DATABASE_HOST=localhost
COURSES_DATABASE_PORT=5432
COURSES_DATABASE_USER=postgres
COURSES_DATABASE_PASSWORD=your_password
COURSES_DATABASE_NAME=courses_db

# DATABASE - CART SERVICE
CART_DATABASE_HOST=localhost
CART_DATABASE_PORT=5432
CART_DATABASE_USER=postgres
CART_DATABASE_PASSWORD=your_password
CART_DATABASE_NAME=cart_db

# GROQ AI (AI-BOT SERVICE)
GROQ_API_KEY=your_groq_api_key

# RABBITMQ
RABBITMQ_URL=amqp://localhost:5672

# EMAIL (NOTIFICATION SERVICE)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# SERVICES PORTS
AI_BOT_SERVICE_PORT=3001
USERS_SERVICE_PORT=3002
COURSES_SERVICE_PORT=3003
CART_SERVICE_PORT=3004
NOTIFICATION_SERVICE_PORT=3005

# NODE ENV
NODE_ENV=development
